                    </div>


                    <div class="flex items-center justify-between text-sm pt-2 border-t border-gray-100">

                        <span class="text-gray-500">
                            â­ MÃ©dia:
                            <strong>{{ item.media }}</strong>
                        </span>

                        <span class="text-gray-500">
                            ðŸ“Š Total:
                            <strong>{{ item.total }}</strong>
                        </span>

                    </div>

                </div>


                {% empty %}


                <div class="col-span-3 text-center text-gray-400 py-10">

                    <div class="text-3xl mb-2">
                        ðŸ‘¤
                    </div>

                    <p>
                        Nenhum funcionÃ¡rio cadastrado.
                    </p>

                </div>


                {% endfor %}

            </div>

        </section>


    </main>



    <!-- ========================================================= -->
    <!-- MODAL DE DETALHES -->
    <!-- ========================================================= -->

    <div id="modal-detalhes" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-titulo"
        onclick="fecharModalExterno(event)">

        <div class="modal-box">


            <div class="modal-header">

                <div>

                    <p class="text-xs text-gray-400 uppercase tracking-widest mb-1">
                        AvaliaÃ§Ã£o
                    </p>

                    <h2 id="modal-titulo" class="text-lg font-bold text-white">
                        Detalhes da AvaliaÃ§Ã£o
                    </h2>

                </div>


                <button class="modal-close" onclick="fecharModal()" aria-label="Fechar">
                    âœ•
                </button>

            </div>


            <div class="modal-body" id="modal-corpo"></div>


            <div class="px-6 pb-6" id="modal-acoes"></div>

        </div>

    </div>



    <!-- ========================================================= -->
    <!-- DADOS DOS GRÃFICOS -->
    <!-- ========================================================= -->

    {{ avaliacoes_categoria|json_script:"dados-categorias" }}

    {{ avaliacoes_nota|json_script:"dados-notas" }}



    <!-- ========================================================= -->
    <!-- JAVASCRIPT -->
    <!-- ========================================================= -->

    <script>


        /* ======================================================= */
        /* GRÃFICOS */
        /* ======================================================= */

        const dc =
            JSON.parse(
                document.getElementById("dados-categorias").textContent
            );


        const dn =
            JSON.parse(
                document.getElementById("dados-notas").textContent
            );


        const ctxCat =
            document.getElementById("graficoCategorias");


        if (ctxCat) {

            new Chart(ctxCat, {

                type: "bar",

                data: {

                    labels: dc.map(
                        i => i.nome
                    ),

                    datasets: [{

                        label: "AvaliaÃ§Ãµes",

                        data: dc.map(
                            i => i.quantidade
                        ),

                        backgroundColor: [
                            "rgba(51,255,0,0.8)",
                            "rgba(51,255,0,0.65)",
                            "rgba(51,255,0,0.5)",
                            "rgba(51,255,0,0.38)",
                            "rgba(51,255,0,0.25)",
                            "rgba(51,255,0,0.15)"
                        ],

                        borderColor: "#33FF00",

                        borderWidth: 1,

                        borderRadius: 6

                    }]

                },

                options: {

                    responsive: true,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            },
                            grid: {
                                color: "#f3f4f6"
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }

                    }

                }

            });

        }



        const ctxNot =
            document.getElementById("graficoNotas");


        if (ctxNot) {

            new Chart(ctxNot, {

                type: "bar",

                data: {

                    labels: dn.map(
                        i => i.nota + " â˜…"
                    ),

                    datasets: [{

                        label: "AvaliaÃ§Ãµes",

                        data: dn.map(
                            i => i.quantidade
                        ),

                        backgroundColor: [
                            "rgba(239,68,68,0.75)",
                            "rgba(249,115,22,0.75)",
                            "rgba(234,179,8,0.75)",
                            "rgba(132,204,22,0.75)",
                            "rgba(34,197,94,0.75)"
                        ],

                        borderWidth: 1,

                        borderRadius: 6

                    }]

                },

                options: {

                    responsive: true,

                    plugins: {

                        legend: {
                            display: false
                        }

                    },

                    scales: {

                        y: {
                            beginAtZero: true,
                            ticks: {
                                stepSize: 1
                            },
                            grid: {
                                color: "#f3f4f6"
                            }
                        },

                        x: {
                            grid: {
                                display: false
                            }
                        }

                    }

                }

            });

        }



        /* ======================================================= */
        /* MODAL DE DETALHES */
        /* ======================================================= */

        function estrelas(nota) {

            let s = "";

            for (let i = 1; i <= 5; i++) {

                s += i <= nota

                    ? '<span style="color:#f59e0b;font-size:1.2rem">â˜…</span>'

                    : '<span style="color:#d1d5db;font-size:1.2rem">â˜…</span>';

            }

            return s;

        }



        function abrirModal(id) {

            const el =
                document.getElementById(
                    "avaliacao-" + id
                );


            if (!el) return;


            const d =
                JSON.parse(
                    el.textContent
                );


            let corpo = "";


            corpo += modalLinha(
                "ðŸ“‚",
                "Categoria",
                d.categoria
            );


            corpo += modalLinha(
                "â­",
                "Nota",
                estrelas(d.nota) +
                ' <span style="color:#6b7280;font-size:0.8rem">(' +
                d.nota +
                '/5)</span>'
            );


            corpo += modalLinha(
                "ðŸ’¬",
                "Tipo de Feedback",
                d.tipo_feedback
            );


            corpo += modalLinha(
                "ðŸ‘¤",
                "FuncionÃ¡rio Avaliado",
                d.funcionario
            );


            corpo += modalLinha(
                "ðŸ“",
                "LocalizaÃ§Ã£o",
                d.localizacao
            );


            corpo += modalLinha(
                "ðŸ•",
                "Data e Hora",
                d.data_criacao
            );


            corpo += modalLinha(
                "ðŸŒ",
                "Origem",
                d.origem
            );


            corpo += `
                <div
                    class="modal-row"
                    style="flex-direction:column;align-items:flex-start"
                >

                    <div
                        style="display:flex;align-items:flex-start;gap:0.75rem;width:100%"
                    >

                        <span class="modal-icon">
                            ðŸ“
                        </span>

                        <div style="flex:1">

                            <p class="modal-label">
                                ComentÃ¡rio do Aluno
                            </p>

                            <p
                                class="modal-value"
                                style="white-space:pre-wrap;line-height:1.6"
                            >
                                ${d.comentario}
                            </p>

                        </div>

                    </div>

                </div>
            `;


            corpo += modalLinha(
                "ðŸ”–",
                "Status Atual",
                d.status
            );


            if (
                d.status_raw === "resolvida" &&
                d.resolvido_por
            ) {

                corpo += modalLinha(
                    "âœ…",
                    "Resolvida por",
                    "<strong>" +
                    d.resolvido_por +
                    "</strong>"
                );


                if (d.data_resolucao) {

                    corpo += modalLinha(
                        "ðŸ“…",
                        "Data de ResoluÃ§Ã£o",
                        d.data_resolucao
                    );

                }

            }


            document.getElementById(
                "modal-corpo"
            ).innerHTML = corpo;


            const filtrosAtivos =
                window.location.search.replace(
                    "?",
                    ""
                );


            document.getElementById(
                "modal-acoes"
            ).innerHTML = `

                <div
                    style="
                        border-top:1px solid #f3f4f6;
                        padding-top:1rem
                    "
                >

                    <p
                        style="
                            font-size:0.75rem;
                            font-weight:700;
                            color:#9ca3af;
                            text-transform:uppercase;
                            letter-spacing:0.07em;
                            margin-bottom:0.75rem
                        "
                    >
                        Alterar Status
                    </p>


                    <form
                        method="post"
                        action="/dashboard/"
                        style="
                            display:flex;
                            gap:0.5rem;
                            flex-wrap:wrap
                        "
                    >

                        <input
                            type="hidden"
                            name="csrfmiddlewaretoken"
                            value="${getCookie('csrftoken')}"
                        >

                        <input
                            type="hidden"
                            name="avaliacao_id"
                            value="${d.id}"
                        >

                        <input
                            type="hidden"
                            name="filtros_ativos"
                            value="${filtrosAtivos}
                        >


                        <button
                            type="submit"
                            name="novo_status"
                            value="pendente"
                            style="
                                flex:1;
                                padding:0.5rem;
                                border-radius:0.5rem;
                                font-size:0.8rem;
                                font-weight:600;
                                border:1px solid #fcd34d;
                                background:#fef3c7;
                                color:#92400e;
                                cursor:pointer
                            "
                        >
                            ðŸ• Pendente
                        </button>


                        <button
                            type="submit"
                            name="novo_status"
                            value="em_analise"
                            style="
                                flex:1;
                                padding:0.5rem;
                                border-radius:0.5rem;
                                font-size:0.8rem;
                                font-weight:600;
                                border:1px solid #93c5fd;
                                background:#dbeafe;
                                color:#1e40af;
                                cursor:pointer
                            "
                        >
                            ðŸ” Em AnÃ¡lise
                        </button>


                        <button
                            type="submit"
                            name="novo_status"
                            value="resolvida"
                            style="
                                flex:1;
                                padding:0.5rem;
                                border-radius:0.5rem;
                                font-size:0.8rem;
                                font-weight:600;
                                border:1px solid #6ee7b7;
                                background:#d1fae5;
                                color:#065f46;
                                cursor:pointer
                            "
                        >
                            âœ… Resolvida
                        </button>

                    </form>

                </div>

            `;


            document
                .getElementById("modal-detalhes")
                .classList.add("ativo");


            document.body.style.overflow = "hidden";

        }



        function modalLinha(
            icon,
            label,
            value
        ) {

            return `

                <div class="modal-row">

                    <span class="modal-icon">
                        ${icon}
                    </span>

                    <div>

                        <p class="modal-label">
                            ${label}
                        </p>

                        <p class="modal-value">
                            ${value}
                        </p>

                    </div>

                </div>

            `;

        }



        function fecharModal() {

            document
                .getElementById("modal-detalhes")
                .classList.remove("ativo");


            document.body.style.overflow = "";

        }



        function fecharModalExterno(e) {

            if (
                e.target ===
                document.getElementById("modal-detalhes")
            ) {

                fecharModal();

            }

        }



        document.addEventListener(
            "keydown",
            e => {

                if (e.key === "Escape") {

                    fecharModal();

                }

            }
        );



        function getCookie(name) {

            let v = null;


            if (
                document.cookie &&
                document.cookie !== ""
            ) {

                document.cookie
                    .split(";")
                    .forEach(c => {

                        c = c.trim();


                        if (
                            c.startsWith(
                                name + "="
                            )
                        ) {

                            v = decodeURIComponent(
                                c.slice(
                                    name.length + 1
                                )
                            );

                        }

                    });

            }


            return v;

        }



        /* ======================================================= */
        /* ANÃLISE COM IA */
        /* ======================================================= */

        async function analisarComIA() {

            const btn =
                document.getElementById(
                    "btn-ia"
                );


            const resultDiv =
                document.getElementById(
                    "ia-resultado"
                );


            const textoDiv =
                document.getElementById(
                    "ia-texto"
                );


            btn.disabled = true;


            btn.innerHTML = `
                <span class="ia-loading">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                Analisando...
            `;


            resultDiv.classList.remove(
                "hidden"
            );


            textoDiv.innerHTML = `
                <span class="ia-loading">
                    <span></span>
                    <span></span>
                    <span></span>
                </span>
                Processando os dados com InteligÃªncia Artificial...
            `;


            try {

                const resp =
                    await fetch(
                        "/ia/analisar/"
                    );


                if (!resp.ok) {

                    throw new Error(
                        "Erro " + resp.status
                    );

                }


                const data =
                    await resp.json();


                textoDiv.innerHTML =
                    formatarTextoIA(
                        data.analise ||
                        "Sem resposta da IA."
                    );


            } catch (err) {

                textoDiv.innerHTML =
                    "âŒ NÃ£o foi possÃ­vel conectar Ã  IA. Verifique a configuraÃ§Ã£o da chave de API.";

            }


            btn.disabled = false;


            btn.innerHTML =
                "âœ¨ Gerar AnÃ¡lise";

        }



        function formatarTextoIA(texto) {

            return texto

                .replace(
                    /\*\*(.*?)\*\*/g,
                    "<strong>$1</strong>"
                )

                .replace(
                    /\*(.*?)\*/g,
                    "<em>$1</em>"
                )

                .replace(
                    /\n/g,
                    "<br>"
                );

        }


        /* =========================================================
                    ASSISTENTE IA â€” POLO FIT
                    ========================================================= */

        const chatForm = document.getElementById("chat-form");
        const chatInput = document.getElementById("chat-input");
        const chatMessages = document.getElementById("chat-mensagens");
        const chatEnviar = document.getElementById("chat-enviar");
        const limparChat = document.getElementById("limpar-chat");
        const chatContador = document.getElementById("chat-contador");
        const chatSugestoes = document.getElementById("chat-sugestoes");


        /* =========================================================
           FORMATAÃ‡ÃƒO SEGURA DA RESPOSTA DA IA
           ========================================================= */

        function formatarTextoIA(texto) {

            if (!texto) {
                return "NÃ£o consegui gerar uma resposta no momento.";
            }

            // Protege o conteÃºdo antes de inserir HTML
            let seguro = String(texto)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");

            // Negrito
            seguro = seguro.replace(
                /\*\*(.*?)\*\*/g,
                "<strong class='text-white font-bold'>$1</strong>"
            );

            // ItÃ¡lico
            seguro = seguro.replace(
                /\*(.*?)\*/g,
                "<em>$1</em>"
            );

            // TÃ­tulos simples
            seguro = seguro.replace(
                /^### (.*?)$/gm,
                "<div class='font-bold text-lime-300 text-sm mt-3 mb-1'>$1</div>"
            );

            seguro = seguro.replace(
                /^## (.*?)$/gm,
                "<div class='font-bold text-lime-300 text-base mt-3 mb-1'>$1</div>"
            );

            // Listas
            seguro = seguro.replace(
                /^[-â€¢] (.*?)$/gm,
                "<div class='flex gap-2 ml-1 my-1'><span class='text-lime-400'>â€¢</span><span>$1</span></div>"
            );

            // NÃºmeros
            seguro = seguro.replace(
                /^(\d+)\. (.*?)$/gm,
                "<div class='flex gap-2 ml-1 my-1'><span class='text-lime-400 font-bold'>$1.</span><span>$2</span></div>"
            );

            // Quebras de linha
            seguro = seguro.replace(/\n/g, "<br>");

            return seguro;
        }


        /* =========================================================
           HORA ATUAL
           ========================================================= */

        function horaAtual() {

            return new Date().toLocaleTimeString(
                "pt-BR",
                {
                    hour: "2-digit",
                    minute: "2-digit"
                }
            );

        }


        /* =========================================================
           ADICIONAR MENSAGEM DO USUÃRIO
           ========================================================= */

        function adicionarMensagemUsuario(mensagem) {

            const wrapper = document.createElement("div");

            wrapper.className = "flex justify-end items-start gap-3";

            wrapper.innerHTML = `
        <div class="max-w-[85%]">

            <div class="flex justify-end items-center gap-2 mb-1">

                <span class="text-[10px] text-slate-500">
                    ${horaAtual()}
                </span>

                <span class="text-xs font-bold text-slate-300">
                    VocÃª
                </span>

            </div>

            <div class="bg-lime-400 text-slate-950 rounded-2xl rounded-tr-md px-4 py-3 text-sm leading-relaxed font-medium shadow-sm">
                ${escapeHTML(mensagem)}
            </div>

        </div>

        <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center">
            ðŸ‘¤
        </div>
    `;

            chatMessages.appendChild(wrapper);

            rolarChat();

        }


        /* =========================================================
           ADICIONAR RESPOSTA DA IA
           ========================================================= */

        function adicionarMensagemIA(texto) {

            const wrapper = document.createElement("div");

            wrapper.className = "flex items-start gap-3";

            wrapper.innerHTML = `
        <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-lime-400/10 border border-lime-400/20 flex items-center justify-center">
            ðŸ¤–
        </div>

        <div class="max-w-[88%]">

            <div class="flex items-center gap-2 mb-1">

                <span class="text-xs font-bold text-lime-300">
                    Assistente Polo Fit
                </span>

                <span class="text-[10px] text-slate-500">
                    ${horaAtual()}
                </span>

            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl rounded-tl-md px-4 py-3 text-sm leading-relaxed text-slate-200 shadow-sm">
                ${formatarTextoIA(texto)}
            </div>

        </div>
    `;

            chatMessages.appendChild(wrapper);

            rolarChat();

        }


        /* =========================================================
           INDICADOR "PENSANDO"
           ========================================================= */

        function adicionarPensando() {

            const wrapper = document.createElement("div");

            wrapper.id = "chat-pensando";

            wrapper.className = "flex items-start gap-3";

            wrapper.innerHTML = `
        <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-lime-400/10 border border-lime-400/20 flex items-center justify-center">
            ðŸ¤–
        </div>

        <div>

            <div class="text-xs font-bold text-lime-300 mb-1">
                Assistente Polo Fit
            </div>

            <div class="bg-slate-900 border border-slate-800 rounded-2xl rounded-tl-md px-4 py-3">

                <div class="flex items-center gap-1">

                    <span class="w-2 h-2 rounded-full bg-lime-400 animate-bounce"></span>

                    <span
                        class="w-2 h-2 rounded-full bg-lime-400 animate-bounce"
                        style="animation-delay:0.15s"
                    ></span>

                    <span
                        class="w-2 h-2 rounded-full bg-lime-400 animate-bounce"
                        style="animation-delay:0.3s"
                    ></span>

                    <span class="ml-2 text-xs text-slate-500">
                        Analisando...
                    </span>

                </div>

            </div>

        </div>
    `;

            chatMessages.appendChild(wrapper);

            rolarChat();

        }


        /* =========================================================
           ROLAGEM
           ========================================================= */

        function rolarChat() {

            chatMessages.scrollTo({
                top: chatMessages.scrollHeight,
                behavior: "smooth"
            });

        }


        /* =========================================================
           ESCAPE HTML
           ========================================================= */

        function escapeHTML(texto) {

            const div = document.createElement("div");

            div.textContent = texto;

            return div.innerHTML;

        }


        /* =========================================================
           ENVIAR PERGUNTA
           ========================================================= */

        async function enviarPergunta(mensagem) {

            if (!mensagem || !chatForm) {
                return;
            }

            adicionarMensagemUsuario(mensagem);

            chatInput.value = "";

            atualizarContador();

            chatInput.disabled = true;
            chatEnviar.disabled = true;

            adicionarPensando();

            try {

                const response = await fetch("/ia/chat/", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json",
                        "X-CSRFToken": getCookie("csrftoken")
                    },

                    body: JSON.stringify({
                        mensagem: mensagem
                    })

                });


                const data = await response.json();


                const pensando = document.getElementById("chat-pensando");

                if (pensando) {
                    pensando.remove();
                }


                if (!response.ok) {

                    adicionarMensagemIA(
                        data.resposta ||
                        data.erro ||
                        "NÃ£o foi possÃ­vel processar sua pergunta."
                    );

                    return;
                }


                adicionarMensagemIA(
                    data.resposta ||
                    "NÃ£o consegui encontrar uma resposta para essa pergunta."
                );


            } catch (error) {

                const pensando = document.getElementById("chat-pensando");

                if (pensando) {
                    pensando.remove();
                }

                adicionarMensagemIA(
                    "NÃ£o consegui conectar ao assistente neste momento. Verifique a conexÃ£o e tente novamente."
                );

                console.error("Erro no chatbot:", error);

            } finally {

                chatInput.disabled = false;
                chatEnviar.disabled = false;

                chatInput.focus();

                rolarChat();

            }

        }


        /* =========================================================
           FORMULÃRIO
           ========================================================= */

        if (chatForm && chatInput) {

            chatForm.addEventListener("submit", function (event) {

                event.preventDefault();

                const mensagem = chatInput.value.trim();

                if (!mensagem) {
                    return;
                }

                enviarPergunta(mensagem);

            });


            /* =====================================================
               ENTER ENVIA
               SHIFT + ENTER QUEBRA LINHA
               ===================================================== */

            chatInput.addEventListener("keydown", function (event) {

                if (event.key === "Enter" && !event.shiftKey) {

                    event.preventDefault();

                    chatForm.requestSubmit();

                }

            });


            /* =====================================================
               CONTADOR
               ===================================================== */

            chatInput.addEventListener("input", atualizarContador);

        }


        /* =========================================================
           CONTADOR
           ========================================================= */

        function atualizarContador() {

            if (!chatContador || !chatInput) {
                return;
            }

            chatContador.textContent =
                `${chatInput.value.length}/1000`;

        }


        /* =========================================================
           SUGESTÃ•ES
           ========================================================= */

        document.querySelectorAll(".sugestao-chat").forEach(function (botao) {

            botao.addEventListener("click", function () {

                const pergunta = this.dataset.pergunta;

                if (!pergunta) {
                    return;
                }

                enviarPergunta(pergunta);

            });

        });


        /* =========================================================
