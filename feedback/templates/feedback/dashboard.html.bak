           ========================================================= */

        if (limparChat) {

            limparChat.addEventListener("click", function () {

                chatMessages.innerHTML = `
            <div class="flex items-start gap-3">

                <div class="flex-shrink-0 w-8 h-8 rounded-xl bg-lime-400/10 border border-lime-400/20 flex items-center justify-center">
                    ðŸ¤–
                </div>

                <div class="max-w-[85%]">

                    <div class="flex items-center gap-2 mb-1">

                        <span class="text-xs font-bold text-lime-300">
                            Assistente Polo Fit
                        </span>

                        <span class="text-[10px] text-slate-500">
                            agora
                        </span>

                    </div>

                    <div class="bg-slate-900 border border-slate-800 rounded-2xl rounded-tl-md px-4 py-3 text-sm leading-relaxed text-slate-200">

                        OlÃ¡! ðŸ‘‹ Como posso ajudar vocÃª hoje?

                    </div>

                </div>

            </div>
        `;

                chatInput.focus();

            });

        }


        /* =========================================================
           FOCO INICIAL
           ========================================================= */

        if (chatInput) {

            atualizarContador();

            chatInput.focus();

        }
    </script>


