{% load static %}
<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% include "feedback/pwa_meta.html" %}

    <meta name="description" content="Dashboard de avaliaÃ§Ãµes Polo Fit â€” anÃ¡lise completa de feedbacks dos alunos.">

    <title>Dashboard â€” Polo Fit</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        body {
            background: linear-gradient(180deg, #f4f7f3 0%, #edf3ef 100%);
        }

        .header-gradient {
            background: linear-gradient(135deg, #0a0a0a 0%, #121a11 42%, #0b2b00 100%);
            border-bottom: 2px solid rgba(163, 230, 53, 0.85);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

        .executive-panel {
            background: linear-gradient(135deg, rgba(10, 10, 10, 0.98) 0%, rgba(16, 25, 13, 0.95) 100%);
            border: 1px solid rgba(163, 230, 53, 0.35);
            box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
        }

        .card-stat {
            background: rgba(255, 255, 255, 0.92);
            border-radius: 1.25rem;
            padding: 1.5rem;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.06);
            border: 1px solid rgba(15, 23, 42, 0.04);
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative;
            overflow: hidden;
        }

        .card-stat::before {
            content: "";
            position: absolute;
            inset: 0 auto auto 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #a3e635, #4ade80, #22c55e);
        }

        .card-stat:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(15, 23, 42, 0.12);
        }

        .tabela-container {
            background: white;
            border-radius: 1.25rem;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.07);
            overflow: hidden;
        }

        thead tr {
            background: #0a0a0a;
            color: white;
        }

        thead th {
            padding: 1rem 1.25rem;
            font-weight: 600;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: background 0.15s;
        }

        tbody tr:hover {
            background: #f9fafb;
        }

        tbody td {
            padding: 0.85rem 1.25rem;
            font-size: 0.875rem;
            vertical-align: middle;
        }

        .badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 12px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-pendente {
            background: #fef3c7;
            color: #92400e;
        }

        .badge-analise {
            background: #dbeafe;
            color: #1e40af;
        }

        .badge-resolvida {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-elogio {
            background: #d1fae5;
            color: #065f46;
        }

        .badge-reclamacao {
            background: #fee2e2;
            color: #991b1b;
        }

        .badge-sugestao {
            background: #ede9fe;
            color: #5b21b6;
        }

        .btn-detalhes {
            background: linear-gradient(135deg, #0a0a0a, #1a1a1a);
            color: #33FF00;
            border: 1px solid #33FF00;
            padding: 5px 14px;
            border-radius: 8px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

        .btn-detalhes:hover {
            background: #33FF00;
            color: #0a0a0a;
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.65);
            backdrop-filter: blur(4px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.25s;
        }

        .modal-overlay.ativo {
            opacity: 1;
            pointer-events: all;
        }

        .modal-box {
            background: white;
            border-radius: 1.5rem;
            max-width: 600px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.35);
            transform: translateY(24px) scale(0.97);
            transition: transform 0.25s;
        }

        .modal-overlay.ativo .modal-box {
            transform: translateY(0) scale(1);
        }

        .modal-header {
            background: linear-gradient(135deg, #0a0a0a, #1a1a1a);
            color: white;
            padding: 1.5rem 1.75rem;
            border-radius: 1.5rem 1.5rem 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .modal-body {
            padding: 1.75rem;
        }

        .modal-row {
            display: flex;
            align-items: flex-start;
            gap: 0.75rem;
            padding: 0.75rem 0;
            border-bottom: 1px solid #f3f4f6;
        }

        .modal-row:last-child {
            border-bottom: none;
        }

        .modal-icon {
            font-size: 1.25rem;
            min-width: 28px;
            text-align: center;
            margin-top: 2px;
        }

        .modal-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.07em;
            color: #9ca3af;
            margin-bottom: 2px;
        }

        .modal-value {
            font-size: 0.9rem;
            color: #111827;
            font-weight: 500;
        }

        .modal-close {
            background: rgba(255, 255, 255, 0.15);
            border: none;
            color: white;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        .modal-close:hover {
            background: rgba(255, 255, 255, 0.3);
        }

        .ia-card {
            background: linear-gradient(135deg, #0a0a0a 0%, #0d1f00 100%);
            border: 1px solid #33FF00;
            border-radius: 1.25rem;
            color: white;
        }

        .ia-resultado {
            background: rgba(51, 255, 0, 0.08);
            border: 1px solid rgba(51, 255, 0, 0.3);
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
            margin-top: 1rem;
            font-size: 0.9rem;
            line-height: 1.7;
            color: #e5e7eb;
            min-height: 80px;
            white-space: pre-wrap;
        }

        .ia-loading {
            display: inline-flex;
            gap: 4px;
            align-items: center;
        }

        .ia-loading span {
            width: 7px;
            height: 7px;
            background: #33FF00;
            border-radius: 50%;
            animation: bounce 0.9s infinite;
        }

        .ia-loading span:nth-child(2) {
            animation-delay: 0.15s;
        }

        .ia-loading span:nth-child(3) {
            animation-delay: 0.3s;
        }

        @keyframes bounce {

            0%,
            80%,
            100% {
                transform: translateY(0)
            }

            40% {
                transform: translateY(-8px)
            }
        }

        .card-ranking {
            background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid #edf2f7;
            border-radius: 1.2rem;
            padding: 1.25rem;
            transition: all 0.2s;
            box-shadow: 0 10px 20px rgba(15, 23, 42, 0.05);
        }

        .card-ranking:hover {
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
            transform: translateY(-2px);
        }

        .ranking-1 {
            border-top: 3px solid #f59e0b;
        }

        .ranking-2 {
            border-top: 3px solid #9ca3af;
        }

        .ranking-3 {
            border-top: 3px solid #b45309;
        }

        select {
            border: 1.5px solid #e5e7eb;
            border-radius: 0.6rem;
            padding: 0.65rem 1rem;
            font-size: 0.875rem;
            background: white;
            transition: border-color 0.2s;
            width: 100%;
        }

        select:focus {
            outline: none;
            border-color: #33FF00;
            box-shadow: 0 0 0 3px rgba(51, 255, 0, 0.15);
        }

        .star-on {
            color: #f59e0b;
        }

        .star-off {
            color: #d1d5db;
        }
    </style>
</head>


<body class="min-h-screen">


    <!-- ========================================================= -->
    <!-- CABEÃ‡ALHO -->
    <!-- ========================================================= -->

    <header class="header-gradient shadow-xl sticky top-0 z-50">

        <div class="max-w-7xl mx-auto px-4 md:px-6 py-3">

            <!-- LINHA PRINCIPAL -->
            <div class="flex justify-between items-center mb-2">
                <div class="flex items-center gap-3">
                    <a href="{% url 'dashboard' %}" class="flex items-center">
                        <img src="{% static 'feedback/LOGO.png' %}" alt="Polo Fit" class="h-10 w-auto object-contain">
                    </a>
                    <div class="hidden md:block">
                        <p class="text-[9px] uppercase tracking-[0.22em] text-lime-300/80">Painel executivo</p>
                        <p class="text-sm font-bold text-white">Polo Feedback</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-gray-400 text-xs hidden md:block">ðŸ‘¤ {{ request.user.username }}</span>
                    <form method="post" action="{% url 'logout' %}">
                        {% csrf_token %}
                        <button type="submit" id="btn-sair"
                            class="bg-white/10 hover:bg-white/20 text-white font-semibold px-3 py-1.5 rounded-lg text-xs transition-all">
                            Sair
                        </button>
                    </form>
                </div>
            </div>

            <!-- MENU DE NAVEGAÃ‡ÃƒO -->
            <nav class="flex items-center gap-1 overflow-x-auto pb-1" style="scrollbar-width:none;">
                <a href="{% url 'avaliar' %}"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    ðŸ  InÃ­cio
                </a>
                <a href="{% url 'dashboard' %}"
                    class="flex-shrink-0 flex items-center gap-1.5 bg-white/10 text-[#a3e635] font-bold px-3 py-1.5 rounded-lg text-xs border border-[#a3e635]/30">
                    ðŸ“Š Dashboard
                </a>
                <a href="{% url 'dashboard' %}#tabela-avaliacoes"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    ðŸ“‹ AvaliaÃ§Ãµes
                </a>
                <a href="{% url 'dashboard' %}#ranking"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    ðŸ‘¥ FuncionÃ¡rios
                </a>
                <a href="#secao-enquete"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    ðŸ“‹ Enquete
                </a>
                <a href="{% url 'gerar_qrcode' %}" id="btn-qrcode"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    ðŸ“± QR Codes
                </a>
                <a href="{% url 'admin:index' %}"
                    class="flex-shrink-0 flex items-center gap-1.5 text-white/70 hover:text-white hover:bg-white/10 font-medium px-3 py-1.5 rounded-lg text-xs transition">
                    âš™ï¸ AdministraÃ§Ã£o
                </a>
            </nav>

        </div>

    </header>



    <!-- ========================================================= -->
    <!-- CONTEÃšDO -->
    <!-- ========================================================= -->

    <main class="max-w-7xl mx-auto px-4 md:px-6 py-8 space-y-8">


        <!-- ===================================================== -->
        <!-- CARDS DE RESUMO -->
        <!-- ===================================================== -->

        <section class="executive-panel rounded-3xl p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
                <div>
                    <p class="text-xs uppercase tracking-[0.22em] text-lime-300/80 mb-2">Resumo operacional</p>
                    <h1 class="text-2xl md:text-3xl font-black text-white">Dashboard de desempenho</h1>
                </div>
                <div
                    class="inline-flex items-center gap-2 bg-white/5 border border-white/10 rounded-full px-3 py-2 text-sm text-gray-200">
                    <span class="w-2.5 h-2.5 rounded-full bg-lime-400"></span>
                    Sistema ativo e atualizado
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">


                <!-- TOTAL -->

                <div class="card-stat">

                    <div class="flex items-center gap-3 mb-3">

                        <div class="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center text-xl">
                            ðŸ“‹
                        </div>

                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                            Total
                        </p>

                    </div>

                    <p class="text-4xl font-extrabold text-gray-900">
                        {{ total_avaliacoes }}
                    </p>

                    <p class="text-xs text-gray-400 mt-1">
                        avaliaÃ§Ãµes registradas
                    </p>

                </div>



                <!-- MÃ‰DIA -->

                <div class="card-stat">

                    <div class="flex items-center gap-3 mb-3">

                        <div class="w-10 h-10 rounded-xl bg-yellow-50 flex items-center justify-center text-xl">
                            â­
                        </div>

                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                            MÃ©dia
                        </p>

                    </div>

                    <p class="text-4xl font-extrabold text-yellow-500">
                        {{ media_notas }}
                    </p>

                    <p class="text-xs text-gray-400 mt-1">
                        nota mÃ©dia geral
                    </p>

                </div>



                <!-- ELOGIOS -->

                <div class="card-stat">

                    <div class="flex items-center gap-3 mb-3">

                        <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-xl">
                            ðŸ‘
                        </div>

                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
