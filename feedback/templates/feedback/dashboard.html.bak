                    </p>

                </div>



                <!-- RECLAMAÃ‡Ã•ES -->

                <div class="card-stat">

                    <div class="flex items-center gap-3 mb-3">

                        <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-xl">
                            âš ï¸
                        </div>

                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wider">
                            ReclamaÃ§Ãµes
                        </p>

                    </div>

                    <p class="text-4xl font-extrabold text-red-600">
                        {{ total_reclamacoes }}
                    </p>

                    <p class="text-xs text-gray-400 mt-1">
                        pontos a melhorar
                    </p>

                </div>

            </div>

        </section>


        <!-- ===================================================== -->
        <!-- ASSISTENTE IA -->
        <!-- ===================================================== -->

        <section class="relative overflow-hidden rounded-3xl bg-slate-950 border border-slate-800 shadow-2xl">

            <!-- Brilho decorativo -->
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-lime-400/10 rounded-full blur-3xl pointer-events-none">
            </div>
            <div
                class="absolute -bottom-24 -left-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none">
            </div>

            <!-- CABEÃ‡ALHO -->
            <div class="relative flex items-center justify-between px-5 md:px-7 py-5 border-b border-slate-800">

                <div class="flex items-center gap-4">

                    <!-- Avatar IA -->
                    <div class="relative flex-shrink-0">

                        <div
                            class="w-12 h-12 rounded-2xl bg-gradient-to-br from-lime-300 to-emerald-500 flex items-center justify-center shadow-lg shadow-lime-500/20">
                            <span class="text-2xl">ðŸ¤–</span>
                        </div>

                        <span
                            class="absolute -right-1 -bottom-1 w-3.5 h-3.5 bg-lime-400 border-2 border-slate-950 rounded-full"></span>

                    </div>

                    <div>

                        <div class="flex items-center gap-2">

                            <h2 class="text-lg md:text-xl font-bold text-white">
                                Assistente Polo Fit
                            </h2>

                            <span
                                class="px-2 py-0.5 rounded-full bg-lime-400/10 border border-lime-400/20 text-[10px] font-bold uppercase tracking-wider text-lime-300">
                                IA
                            </span>

                        </div>

                        <p class="text-xs md:text-sm text-slate-400 mt-0.5">
                            Seu assistente para analisar a academia e tomar decisÃµes.
                        </p>

                    </div>

                </div>


                <!-- AÃ‡Ã•ES -->
                <div class="flex items-center gap-2">

                    <span
                        class="hidden md:flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-lime-300">
                        <span class="w-2 h-2 bg-lime-400 rounded-full animate-pulse"></span>
                        Online
                    </span>

                    <button type="button" id="limpar-chat"
                        class="w-9 h-9 rounded-xl bg-slate-900 hover:bg-slate-800 border border-slate-700 text-slate-400 hover:text-white transition"
                        title="Limpar conversa">
                        ðŸ—‘ï¸
                    </button>

                </div>

            </div>


            <!-- ÃREA DA CONVERSA -->
            <div id="chat-mensagens"
                class="relative h-[360px] md:h-[400px] overflow-y-auto px-4 md:px-6 py-5 space-y-5 scrollbar-thin">

                <!-- MENSAGEM INICIAL DA IA -->
                <div class="flex items-start gap-3">

                    <div
                        class="flex-shrink-0 w-8 h-8 rounded-xl bg-lime-400/10 border border-lime-400/20 flex items-center justify-center">
                        ðŸ¤–
                    </div>

                    <div class="max-w-[85%]">

                        <div class="flex items-center gap-2 mb-1">
                            <span class="text-xs font-bold text-lime-300">
                                Assistente Polo Fit
                            </span>

                            <span class="text-[10px] text-slate-500">
                                agora
                            </span>
                        </div>

                        <div
                            class="bg-slate-900 border border-slate-800 rounded-2xl rounded-tl-md px-4 py-3 text-sm leading-relaxed text-slate-200 shadow-sm">

                            <p class="mb-2">
                                OlÃ¡! ðŸ‘‹ Sou o assistente inteligente da <strong class="text-white">Polo Fit</strong>.
                            </p>

                            <p class="text-slate-400">
                                Posso ajudar vocÃª a analisar avaliaÃ§Ãµes, reclamaÃ§Ãµes,
                                sugestÃµes, funcionÃ¡rios, desempenho e oportunidades de melhoria.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- SUGESTÃ•ES -->
                <div id="chat-sugestoes" class="pl-11">

                    <p class="text-[11px] text-slate-500 mb-2">
                        SugestÃµes para comeÃ§ar
                    </p>

                    <div class="flex flex-wrap gap-2">

                        <button type="button"
                            class="sugestao-chat px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:border-lime-400/50 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition"
                            data-pergunta="Como estÃ¡ a satisfaÃ§Ã£o dos alunos atualmente?">
                            ðŸ“Š SatisfaÃ§Ã£o dos alunos
                        </button>

                        <button type="button"
                            class="sugestao-chat px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:border-lime-400/50 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition"
                            data-pergunta="Quais sÃ£o as principais reclamaÃ§Ãµes dos alunos?">
                            âš ï¸ Principais reclamaÃ§Ãµes
                        </button>

                        <button type="button"
                            class="sugestao-chat px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:border-lime-400/50 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition"
                            data-pergunta="Quais funcionÃ¡rios estÃ£o se destacando nas avaliaÃ§Ãµes?">
                            ðŸ† FuncionÃ¡rios destaque
                        </button>

                        <button type="button"
                            class="sugestao-chat px-3 py-2 rounded-xl bg-slate-900 border border-slate-800 hover:border-lime-400/50 hover:bg-slate-800 text-xs text-slate-300 hover:text-white transition"
                            data-pergunta="Quais melhorias deveriam ser priorizadas pela academia?">
                            ðŸ’¡ Melhorias prioritÃ¡rias
                        </button>

                    </div>

                </div>

            </div>


            <!-- CAMPO DE MENSAGEM -->
            <div class="relative border-t border-slate-800 bg-slate-950/90 p-4 md:p-5">

                <form id="chat-form" class="relative">

                    <div class="flex items-end gap-2">

                        <div class="relative flex-1">

                            <textarea id="chat-input" rows="1" maxlength="1000"
                                placeholder="Pergunte alguma coisa sobre a Polo Fit..."
                                class="w-full resize-none rounded-2xl bg-slate-900 border border-slate-700 text-white placeholder-slate-500 px-4 py-3.5 pr-12 text-sm focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/10 transition"></textarea>

                            <div class="absolute right-3 bottom-3 text-[10px] text-slate-600">
                                Enter â†µ
                            </div>

                        </div>


                        <button id="chat-enviar" type="submit"
                            class="flex-shrink-0 w-12 h-12 rounded-2xl bg-lime-400 hover:bg-lime-300 text-slate-950 font-black flex items-center justify-center shadow-lg shadow-lime-500/10 transition disabled:opacity-50 disabled:cursor-not-allowed"
                            title="Enviar mensagem">
                            âž¤
                        </button>

                    </div>

                    <div class="flex items-center justify-between mt-2 px-1">

                        <span class="text-[10px] text-slate-600">
                            O assistente utiliza os dados disponÃ­veis no sistema.
                        </span>

                        <span id="chat-contador" class="text-[10px] text-slate-600">
                            0/1000
                        </span>

                    </div>

                </form>

            </div>

        </section>




        <!-- ===================================================== -->
        <!-- GRÃFICOS -->
        <!-- ===================================================== -->

        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">


            <div class="bg-white rounded-2xl shadow p-6 border border-slate-100">

                <h3 class="font-bold text-gray-800 mb-1">
                    ðŸ“Š AvaliaÃ§Ãµes por Categoria
                </h3>

                <p class="text-xs text-gray-400 mb-4">
                    DistribuiÃ§Ã£o dos feedbacks
                </p>

                <canvas id="graficoCategorias"></canvas>

            </div>


            <div class="bg-white rounded-2xl shadow p-6 border border-slate-100">

                <h3 class="font-bold text-gray-800 mb-1">
                    â­ AvaliaÃ§Ãµes por Nota
                </h3>

                <p class="text-xs text-gray-400 mb-4">
                    Quantidade por estrelas
                </p>

                <canvas id="graficoNotas"></canvas>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- AVALIAÃ‡Ã•ES POR LOCAL                                  -->
        <!-- ===================================================== -->

        {% if locais_ranking %}
        <section class="bg-white rounded-2xl shadow p-6 border border-slate-100">

            <div class="flex items-center justify-between mb-5">
                <div>
                    <h3 class="font-bold text-gray-800">ðŸ“ AvaliaÃ§Ãµes por Local</h3>
                    <p class="text-xs text-gray-400 mt-0.5">Qual espaÃ§o estÃ¡ recebendo mais feedback?</p>
                </div>
                <a href="{% url 'gerar_qrcode' %}"
                    class="text-xs font-semibold text-[#33FF00] border border-[#33FF00] px-3 py-1.5 rounded-lg hover:bg-[#0a0a0a] transition">
                    ðŸ“± Gerar QR Codes
                </a>
            </div>

            <div class="space-y-3">
                {% for local in locais_ranking %}
                <div class="flex items-center gap-3">
                    <span class="text-xl w-8 text-center flex-shrink-0">{{ local.icone }}</span>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-sm font-semibold text-gray-700 truncate">{{ local.nome }}</span>
                            <div class="flex items-center gap-2 flex-shrink-0 ml-2">
                                <span class="text-xs text-yellow-500 font-bold">â­ {{ local.media }}</span>
                                <span class="text-xs text-gray-400">{{ local.total }} aval.</span>
                                <a href="{% url 'gerar_qrcode' %}?localizacao={{ local.nome|urlencode }}"
                                    class="text-[11px] font-bold text-[#33FF00] bg-[#0a0a0a] hover:bg-[#1a1a1a] px-2 py-0.5 rounded transition shadow-sm"
                                    title="Gerar QR Code para {{ local.nome }}">
                                    ðŸ“± QR Code
                                </a>
                            </div>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-2">
                            <div class="bg-gradient-to-r from-[#a3e635] to-[#4ade80] h-2 rounded-full transition-all"
                                style="width: {% widthratio local.total locais_ranking.0.total 100 %}%"></div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

        </section>
        {% endif %}

        <!-- ===================================================== -->
        <!-- SEÃ‡ÃƒO: ENQUETE DE SATISFAÃ‡ÃƒO (AULAS & NOVOS ESPAÃ‡OS)  -->
        <!-- ===================================================== -->
        <section id="secao-enquete" class="bg-white rounded-2xl shadow p-6 border border-slate-100">
            <div
                class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 pb-4 border-b border-gray-100">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="text-xl">ðŸ“‹</span>
                        <h3 class="font-extrabold text-gray-900 text-lg">Enquete de SatisfaÃ§Ã£o â€” Aulas Coletivas & Novos
                            EspaÃ§os</h3>
                    </div>
                    <p class="text-xs text-gray-500 mt-1">
                        Resultados da pesquisa oficial dos alunos sobre preferÃªncias de modalidades e expansÃµes da
                        academia.
                    </p>
                </div>
                <div class="flex items-center gap-2 flex-wrap">
                    <span
                        class="inline-flex items-center gap-1.5 bg-lime-100 text-lime-900 text-xs font-bold px-3 py-1.5 rounded-xl border border-lime-300">
                        âš¡ {{ total_enquetes }} respostas coletadas
                    </span>
                    <a href="{% url 'gerar_qrcode' %}?localizacao=Enquete+de+Satisfa%C3%A7%C3%A3o"
                        class="text-xs font-bold text-black bg-[#a3e635] hover:bg-[#bef264] px-3 py-1.5 rounded-xl transition shadow-sm flex items-center gap-1">
                        ðŸ“± QR Code da Enquete
                    </a>
                    <a href="{% url 'enquete' %}" target="_blank"
                        class="text-xs font-bold text-gray-700 bg-gray-100 hover:bg-gray-200 px-3 py-1.5 rounded-xl transition flex items-center gap-1">
                        ðŸ”— Abrir FormulÃ¡rio â†—
                    </a>
                </div>
            </div>

            {% if total_enquetes == 0 %}
            <div class="bg-gray-50 border border-dashed border-gray-200 rounded-2xl p-8 text-center">
                <span class="text-3xl block mb-2">ðŸ“‹</span>
                <p class="font-bold text-gray-700 text-sm">Nenhuma resposta de enquete registrada ainda.</p>
                <p class="text-xs text-gray-400 mt-1">Imprima o QR Code da Enquete e divulgue para os alunos responderem
                    pelo celular!</p>
                <div class="mt-4 flex justify-center gap-2">
                    <a href="{% url 'enquete' %}" target="_blank"
                        class="text-xs font-bold text-[#33FF00] bg-[#0a0a0a] px-3.5 py-2 rounded-xl transition">
                        Responder Primeiro Teste âž”
                    </a>
                </div>
            </div>
            {% else %}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- 1. AULAS FAVORITAS -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4">
                    <h4
                        class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
                        <span>ðŸ”¥</span> 1. Aulas Mais Populares / Favoritas
                    </h4>
                    <div class="space-y-2.5">
                        {% for aula, qtd in favoritas_ranking %}
                        <div>
                            <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                                <span>{{ aula }}</span>
                                <span class="text-slate-500">{{ qtd }} voto{{ qtd|pluralize:"s" }}</span>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-2">
                                <div class="bg-gradient-to-r from-[#a3e635] to-[#22c55e] h-2 rounded-full"
                                    style="width: {% widthratio qtd total_enquetes 100 %}%"></div>
                            </div>
                        </div>
                        {% empty %}
                        <p class="text-xs text-gray-400">Sem dados ainda.</p>
                        {% endfor %}
                    </div>
                </div>

                <!-- 3. NOVOS ESPAÃ‡OS DESEJADOS -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4">
                    <h4
                        class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
                        <span>ðŸ—ï¸</span> 3. Novos EspaÃ§os Mais Desejados
                    </h4>
                    <div class="space-y-2.5">
                        {% for espaco, qtd in espacos_ranking %}
                        <div>
                            <div class="flex justify-between text-xs font-semibold text-slate-700 mb-1">
                                <span class="truncate max-w-[200px]">{{ espaco }}</span>
                                <span class="text-slate-500">{{ qtd }} voto{{ qtd|pluralize:"s" }}</span>
                            </div>
                            <div class="w-full bg-slate-200 rounded-full h-2">
                                <div class="bg-gradient-to-r from-blue-400 to-indigo-500 h-2 rounded-full"
                                    style="width: {% widthratio qtd total_enquetes 100 %}%"></div>
                            </div>
                        </div>
                        {% empty %}
                        <p class="text-xs text-gray-400">Sem dados ainda.</p>
                        {% endfor %}
                    </div>
                </div>

                <!-- 2. PARTICIPAÃ‡ÃƒO EM AULAS COLETIVAS -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4">
                    <h4
                        class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
                        <span>ðŸ‘¥</span> 2. FrequÃªncia em Aulas Coletivas
                    </h4>
                    <div class="space-y-2">
                        {% for item, qtd in participacao_ranking %}
                        <div
                            class="flex items-center justify-between text-xs p-2 bg-white rounded-xl border border-slate-200">
                            <span class="font-medium text-slate-700">{{ item }}</span>
                            <span class="font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded">{{ qtd }}</span>
                        </div>
                        {% empty %}
                        <p class="text-xs text-gray-400">Sem dados ainda.</p>
                        {% endfor %}
                    </div>
                </div>

                <!-- 4. AULAS QUE PRECISAM DE ATENÃ‡ÃƒO -->
                <div class="bg-slate-50 border border-slate-200/80 rounded-2xl p-4">
                    <h4
                        class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
                        <span>âš ï¸</span> 4. Aulas que Precisam de Mais AtenÃ§Ã£o
                    </h4>
                    <div class="space-y-2">
                        {% for aula, qtd in melhorias_ranking %}
                        <div
                            class="flex items-center justify-between text-xs p-2 bg-white rounded-xl border border-slate-200">
                            <span class="font-medium text-slate-700">{{ aula }}</span>

                            <span class="font-bold text-amber-600 bg-amber-50 px-2 py-0.5 rounded">
                                {{ qtd }}
                                {% if qtd == 1 %}
                                voto
                                {% else %}
                                votos
                                {% endif %}
                            </span>
                        </div>
                        {% empty %}
                        <p class="text-xs text-gray-400">Sem dados ainda.</p>
                        {% endfor %}
                    </div>
                </div>

            </div>

            <!-- MURAL DE SUGESTÃ•ES E ELOGIOS RECENTES DA ENQUETE -->
            {% if ultimas_enquetes %}
            <div class="mt-6 pt-5 border-t border-slate-200">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600 mb-3">
                    ðŸ’¬ Ãšltimas ContribuiÃ§Ãµes dos Alunos (Perguntas 5 e 6):
                </h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {% for resp in ultimas_enquetes %}
                    {% if resp.sugestao_valor or resp.elogio_colaborador or resp.aula_falta %}
                    <div class="p-3 bg-white border border-slate-200 rounded-xl text-xs space-y-1.5 shadow-sm">

                        <div class="flex justify-between text-[11px] text-slate-400">
                            <span>Resposta #{{ resp.id }}</span>
                            <span>{{ resp.data_criacao|date:"d/m H:i" }}</span>
                        </div>

                        {% if resp.aula_falta %}
                        <p>
                            <strong class="text-slate-700">Sente falta de:</strong>
                            <span class="text-slate-600">{{ resp.aula_falta }}</span>
                        </p>
                        {% endif %}

                        {% if resp.sugestao_valor %}
                        <p>
                            <strong class="text-slate-700">Agregaria valor:</strong>
                            <span class="text-slate-600">{{ resp.sugestao_valor }}</span>
                        </p>
                        {% endif %}

                        {% if resp.elogio_colaborador %}
                        <p class="text-emerald-700 bg-emerald-50 p-1.5 rounded-lg">
                            <strong>ðŸ’š Elogio:</strong>
                            {{ resp.elogio_colaborador }}
                        </p>
                        {% endif %}

                    </div>
                    {% endif %}
                    {% endfor %}
                </div>
            </div>
            {% endif %}

            {% endif %}
        </section>



        <!-- ===================================================== -->
        <!-- FILTROS -->
        <!-- ===================================================== -->

        <section class="bg-white rounded-2xl shadow p-6 border border-slate-100">

            <div class="flex items-center justify-between gap-3 mb-4">
                <h3 class="font-bold text-gray-800">
                    ðŸ” Filtrar AvaliaÃ§Ãµes
                </h3>
                <div class="flex items-center gap-2">
                    {% if periodo_filtro == 'hoje' %}
                    <span class="text-xs font-semibold bg-lime-100 text-lime-700 px-2.5 py-1 rounded-full">ðŸ“…
                        Hoje</span>
                    {% elif periodo_filtro == 'semana' %}
                    <span class="text-xs font-semibold bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full">ðŸ“… Esta
                        semana</span>
                    {% elif periodo_filtro == 'mes' %}
                    <span class="text-xs font-semibold bg-purple-100 text-purple-700 px-2.5 py-1 rounded-full">ðŸ“…
                        Ãšltimos 30 dias</span>
                    {% else %}
                    <span class="text-[10px] uppercase tracking-[0.18em] text-slate-400">filtros ativos</span>
                    {% endif %}
                </div>
            </div>


            <form method="get" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">


                <!-- PERÃODO -->

                <select name="periodo" id="filtro-periodo">
                    <option value="">Todo perÃ­odo</option>
                    <option value="hoje" {% if periodo_filtro == 'hoje' %}selected{% endif %}>ðŸ“… Hoje</option>
                    <option value="semana" {% if periodo_filtro == 'semana' %}selected{% endif %}>ðŸ“… Esta semana</option>
                    <option value="mes" {% if periodo_filtro == 'mes' %}selected{% endif %}>ðŸ“… Ãšltimos 30 dias</option>
                </select>


                <!-- CATEGORIA -->

                <select name="categoria" id="filtro-categoria">

                    <option value="">
                        Todas categorias
                    </option>

                    {% for codigo, nome in categorias %}
                    <option value="{{ codigo }}" {% if categoria_filtro == codigo %}selected{% endif %}>
                        {{ nome }}
                    </option>
                    {% endfor %}
                </select>

                <select name="tipo" id="filtro-tipo">
                    <option value="">
                        Todos tipos
                    </option>
                    {% for codigo, nome in tipos_feedback %}
                    <option value="{{ codigo }}" {% if tipo_filtro == codigo %}selected{% endif %}>
                        {{ nome }}
                    </option>
                    {% endfor %}
                </select>

                <select name="status" id="filtro-status">
                    <option value="">
                        Todos status
                    </option>
                    {% for codigo, nome in status_choices %}
                    <option value="{{ codigo }}" {% if status_filtro == codigo %}selected{% endif %}>
                        {{ nome }}
                    </option>
                    {% endfor %}
                </select>

                <select name="funcionario" id="filtro-funcionario">
                    <option value="">
                        Todos funcionÃ¡rios
                    </option>
                    {% for func in funcionarios %}
 <option value={{ func.id }} {% if funcionario_filtro == func.id|stringformat:s %}selected{% endif %}>
                        %}>
                        {{ func.nome }}
                    </option>
                    {% endfor %}
                </select>



                <!-- BOTÃ•ES -->

                <div class="flex gap-3 sm:col-span-2 md:col-span-3 lg:col-span-5">

                    <button type="submit" id="btn-filtrar"
                        class="flex-1 bg-[#0a0a0a] hover:bg-[#1a1a1a] text-[#33FF00] border border-[#33FF00] font-bold py-2.5 rounded-xl transition-all duration-200">
                        Filtrar
                    </button>


                    <a href="{% url 'dashboard' %}" id="btn-limpar"
                        class="flex-1 bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 rounded-xl text-center transition-all duration-200">
                        Limpar Filtros
                    </a>

                </div>

            </form>

        </section>



        <!-- ===================================================== -->
        <!-- TABELA DE AVALIAÃ‡Ã•ES -->
        <!-- ===================================================== -->

        <section id="tabela-avaliacoes">

            <div class="flex items-center justify-between mb-4">

                <h2 class="text-xl font-bold text-gray-800">
                    ðŸ“ AvaliaÃ§Ãµes Recentes
                </h2>


                <span class="text-sm text-gray-400 bg-white px-3 py-1 rounded-full shadow">

                    {{ total_avaliacoes }}

                    resultado{% if total_avaliacoes != 1 %}s{% endif %}

                </span>

            </div>


            <div class="tabela-container overflow-x-auto">

                <table class="w-full text-sm text-left">


                    <thead>

                        <tr>

                            <th>
                                Categoria
                            </th>

                            <th>
                                FuncionÃ¡rio
                            </th>

                            <th>
                                Nota
                            </th>

                            <th>
                                Tipo
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Data
                            </th>

                            <th class="text-center">
                                Detalhes
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                        {% for a in avaliacoes %}


                        <tr>


                            <!-- CATEGORIA -->

                            <td>

                                <span class="font-medium text-gray-800">
                                    {{ a.get_categoria_display }}
                                </span>

                            </td>



                            <!-- FUNCIONÃRIO -->

                            <td>

                                {% if a.funcionario %}

                                <div class="flex items-center gap-2">

                                    {% if a.funcionario.foto %}

                                    <img src="{{ a.funcionario.foto.url }}" alt="{{ a.funcionario.nome }}"
                                        class="w-7 h-7 rounded-full object-cover border border-gray-200">

                                    {% else %}

                                    <div
                                        class="w-7 h-7 rounded-full bg-gradient-to-br from-gray-800 to-green-600 flex items-center justify-center text-white text-xs font-bold">
                                        {{ a.funcionario.nome|slice:":1" }}
                                    </div>

                                    {% endif %}


                                    <span class="font-medium">
                                        {{ a.funcionario.nome }}
                                    </span>

                                </div>

                                {% else %}

                                <span class="text-gray-400 italic">
                                    NÃ£o informado
                                </span>

                                {% endif %}

                            </td>



                            <!-- NOTA -->

                            <td>

                                <span>

                                    {% for i in "12345" %}

                                    {% if forloop.counter <= a.nota %} <span class="star-on">â˜…</span>

                                {% else %}

                                <span class="star-off">â˜…</span>

                                {% endif %}

                                {% endfor %}

                                </span>

                            </td>



                            <!-- TIPO -->

                            <td>

                                {% if a.tipo_feedback == "elogio" %}

                                <span class="badge badge-elogio">
                                    ðŸ‘ Elogio
                                </span>

                                {% elif a.tipo_feedback == "reclamacao" %}

                                <span class="badge badge-reclamacao">
                                    âš ï¸ ReclamaÃ§Ã£o
                                </span>

                                {% else %}

                                <span class="badge badge-sugestao">
                                    ðŸ’¡ SugestÃ£o
                                </span>

                                {% endif %}

                            </td>



                            <!-- STATUS -->

                            <td>

                                {% if a.status == "resolvida" %}

                                <span class="badge badge-resolvida">
                                    âœ… Resolvida
                                </span>

                                {% elif a.status == "em_analise" %}

                                <span class="badge badge-analise">
                                    ðŸ” Em anÃ¡lise
                                </span>

                                {% else %}

                                <span class="badge badge-pendente">
                                    ðŸ• Pendente
                                </span>

                                {% endif %}

                            </td>



                            <!-- DATA -->

                            <td class="text-gray-500 whitespace-nowrap">

                                {{ a.data_criacao|date:"d/m/Y H:i" }}

                            </td>



                            <!-- DETALHES -->

                            <td class="text-center">

                                <button class="btn-detalhes" id="btn-detalhes-{{ a.pk }}"
                                    onclick="abrirModal({{ a.pk }})" title="Ver detalhes">
                                    ðŸ”Ž Ver detalhes
                                </button>

                            </td>

                        </tr>



                        <!-- DADOS DO MODAL -->

                        <script type="application/json" id="avaliacao-{{ a.pk }}">
                        {
                            "id": {{ a.pk }},
                            "categoria": "{{ a.get_categoria_display|escapejs }}",
                            "nota": {{ a.nota }},
                            "tipo_feedback": "{% if a.tipo_feedback == 'elogio' %}ðŸ‘ Elogio{% elif a.tipo_feedback == 'reclamacao' %}âš ï¸ ReclamaÃ§Ã£o{% else %}ðŸ’¡ SugestÃ£o{% endif %}",
                            "funcionario": "{% if a.funcionario %}{{ a.funcionario.nome|escapejs }}{% if a.funcionario.cargo %} â€” {{ a.funcionario.cargo|escapejs }}{% endif %}{% else %}NÃ£o informado{% endif %}",
                            "comentario": "{{ a.comentario|default:'Sem comentÃ¡rio'|escapejs }}",
                            "localizacao": "{{ a.localizacao|default:'NÃ£o informada'|escapejs }}",
                            "data_criacao": "{{ a.data_criacao|date:'d/m/Y H:i' }}",
                            "status": "{% if a.status == 'resolvida' %}âœ… Resolvida{% elif a.status == 'em_analise' %}ðŸ” Em AnÃ¡lise{% else %}ðŸ• Pendente{% endif %}",
                            "status_raw": "{{ a.status }}",
                            "resolvido_por": "{% if a.resolvido_por %}{{ a.resolvido_por.username|escapejs }}{% endif %}",
                            "data_resolucao": "{% if a.data_resolucao %}{{ a.data_resolucao|date:'d/m/Y H:i' }}{% endif %}",
                            "origem": "{% if a.origem == 'gerente' %}Gerente/Admin{% else %}Aluno (QR Code){% endif %}"
                        }
                        </script>


                        {% empty %}


                        <tr>

                            <td colspan="7" class="py-16 text-center text-gray-400">

                                <div class="text-4xl mb-3">
                                    ðŸ“­
                                </div>

                                <p class="font-medium">
                                    Nenhuma avaliaÃ§Ã£o encontrada
                                </p>

                                <p class="text-sm mt-1">
                                    Tente remover algum filtro
                                </p>

                            </td>

                        </tr>


                        {% endfor %}


                    </tbody>

                </table>

            </div>

        </section>



        <!-- ===================================================== -->
        <!-- RANKING -->
        <!-- ===================================================== -->

        <section id="ranking">

            <h2 class="text-xl font-bold text-gray-800 mb-4">
                ðŸ† Ranking de FuncionÃ¡rios
            </h2>


            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">


                {% for item in ranking_funcionarios %}


                <div class="card-ranking
                    {% if forloop.counter == 1 %}
                        ranking-1
                    {% elif forloop.counter == 2 %}
                        ranking-2
                    {% elif forloop.counter == 3 %}
                        ranking-3
                    {% endif %}">


                    <div class="flex items-center gap-3 mb-4">

                        <span class="text-2xl">

                            {% if forloop.counter == 1 %}
                            ðŸ¥‡
                            {% elif forloop.counter == 2 %}
                            ðŸ¥ˆ
                            {% elif forloop.counter == 3 %}
                            ðŸ¥‰
                            {% else %}
                            #{{ forloop.counter }}
                            {% endif %}

                        </span>


                        {% if item.foto %}

                        <img src="{{ item.foto }}" alt="{{ item.nome }}"
                            class="w-12 h-12 rounded-full object-cover border-2 border-gray-100">

                        {% else %}

                        <div
                            class="w-12 h-12 rounded-full bg-gradient-to-br from-gray-800 to-green-600 flex items-center justify-center text-white font-bold text-lg">
                            {{ item.nome|slice:":1" }}
                        </div>

                        {% endif %}


                        <div>

                            <p class="font-bold text-gray-900">
                                {{ item.nome }}
                            </p>


                            {% if item.cargo %}

                            <p class="text-xs text-gray-400">
                                {{ item.cargo }}
                            </p>

                            {% endif %}

                        </div>

                    </div>



                    <div class="grid grid-cols-3 gap-2 text-center mb-3">


                        <div class="bg-green-50 rounded-lg p-2">

