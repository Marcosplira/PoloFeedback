# =============================================================
# .env.example — Polo Feedback
# =============================================================
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp .env.example .env
#
# NUNCA comite o arquivo .env no repositório!
# =============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
# Chave secreta Django — gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# "True" para desenvolvimento local, "False" para produção
DEBUG=False

# Hosts permitidos (separados por vírgula) — usado quando DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,polofeedback.pythonanywhere.com

# Origens CSRF confiáveis (separadas por vírgula) — usado quando DEBUG=False
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://polofeedback.pythonanywhere.com

# ------------------------------------------------------------
# Banco de Dados
# ------------------------------------------------------------
# Local sem DATABASE_URL usa SQLite somente quando DEBUG=True.
# Produção exige um banco PostgreSQL persistente.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/polofeedback

# ------------------------------------------------------------
# Contas privadas do Dashboard
# ------------------------------------------------------------
DASHBOARD_MANAGER_USERNAME=gerente
DASHBOARD_MANAGER_PASSWORD=
DASHBOARD_OWNER_USERNAME=marcos
DASHBOARD_OWNER_PASSWORD=

# ------------------------------------------------------------
# Google Gemini IA (opcional — funciona com fallback local)
# ------------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# Alertas de avaliações pelo WhatsApp Business (opcional/desligado)
# Só habilite após aprovar o modelo de mensagem na Meta e atualizar
# a informação de privacidade exibida no formulário.
# ------------------------------------------------------------
WHATSAPP_ALERTS_ENABLED=False
WHATSAPP_CLOUD_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_ALERT_RECIPIENT=
WHATSAPP_ALERT_TEMPLATE_NAME=polo_feedback_nova_avaliacao
WHATSAPP_ALERT_TEMPLATE_LANGUAGE=pt_BR
SITE_PUBLIC_URL=

# ------------------------------------------------------------
# Banco do Docker Compose — gere uma senha forte, apenas com letras e números.
# Se usar outros símbolos, codifique-os no formato URL na DATABASE_URL.
# ------------------------------------------------------------
DB_PASSWORD=
POSTGRES_DB=polofeedback
POSTGRES_USER=polo
APP_PORT=8000
