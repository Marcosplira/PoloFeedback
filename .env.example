# =============================================================
# .env.example — Polo Feedback
# =============================================================
# Copie este arquivo para .env e preencha com seus valores reais:
#   cp .env.example .env
#
# NUNCA comite o arquivo .env no repositório!
# =============================================================

# ------------------------------------------------------------
# Django
# ------------------------------------------------------------
# Chave secreta Django — gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-sua-chave-secreta-aqui

# "True" para desenvolvimento local, "False" para produção
DEBUG=True

# Hosts permitidos (separados por vírgula) — usado quando DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Origens CSRF confiáveis (separadas por vírgula) — usado quando DEBUG=False
CSRF_TRUSTED_ORIGINS=https://seudominio.com

# ------------------------------------------------------------
# Banco de Dados (opcional — padrão: SQLite local)
# ------------------------------------------------------------
# URL do PostgreSQL. Se não definida, usa SQLite automaticamente.
# DATABASE_URL=postgres://usuario:senha@localhost:5432/polofeedback

# ------------------------------------------------------------
# Google Gemini IA (opcional — funciona com fallback local)
# ------------------------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua-chave-gemini-aqui
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------
# Senha do Admin Django (usado pelo build.sh e docker-compose)
# ------------------------------------------------------------
DJANGO_ADMIN_PASSWORD=troque-para-uma-senha-segura

# ------------------------------------------------------------
# Docker Compose (apenas para uso local com docker compose)
# ------------------------------------------------------------
DB_PASSWORD=polofit_dev_2026
